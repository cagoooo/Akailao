{
  "manifest_version": 3,
  "name": "剛好學 課堂互動助手",
  "short_name": "剛好學",
  "version": "1.0.0",
  "description": "在 Chrome 側邊欄直接使用「剛好學」課堂互動系統：一鍵把目前網頁變成閱讀測驗、截圖出題、派送網址給學生。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "開啟剛好學側邊欄",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://cagoooo.github.io/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "開啟剛好學側邊欄"
    }
  }
}
