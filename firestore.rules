rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 教師個人資料：只有本人可讀寫
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 🆕 [V4.0] 老師帳號資料（Google 登入才能寫）
    match /teachers/{teacherId} {
      // 個人資料（教室代碼、名稱等）
      match /private/{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == teacherId
                           && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      // 雲端題庫
      match /questionBanks/{bankId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == teacherId
                           && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }

    // ===== 🆕 [V4.6.0] 教室代碼「先申請先用」 =====
    // 同一個代碼不分帳號都是同一間教室，所以代碼要有主人：
    //   classroomClaims/{代碼}                     主人（ownerUid）與最後使用時間
    //   classroomClaims/{代碼}/members/{老師uid}   協同老師（用邀請碼加入）
    //   classroomClaims/{代碼}/invite/current      邀請碼（只有主人看得到）
    // 學生（匿名登入）照舊可以作答；Google 登入的老師只能操作自己（或受邀）的教室。
    // 主人 30 天沒用，其他老師可以接手；保留代碼不會被接手。

    function signedIn() { return request.auth != null; }
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // 保留代碼：只有指定帳號能申請（存 Email 的 SHA-256，不放明文 Email）
    function reservedCodes() {
      return {
        '601': '92bcd66f6230e1ebd5090bde274e6b39f86600638efbfb0719c204d3ce7e2cea',
        '602': '92bcd66f6230e1ebd5090bde274e6b39f86600638efbfb0719c204d3ce7e2cea',
        '603': '92bcd66f6230e1ebd5090bde274e6b39f86600638efbfb0719c204d3ce7e2cea',
        '604': '92bcd66f6230e1ebd5090bde274e6b39f86600638efbfb0719c204d3ce7e2cea',
        '605': '92bcd66f6230e1ebd5090bde274e6b39f86600638efbfb0719c204d3ce7e2cea',
        '606': '92bcd66f6230e1ebd5090bde274e6b39f86600638efbfb0719c204d3ce7e2cea'
      };
    }
    function isReserved(code) { return code in reservedCodes(); }
    function myEmailHash() {
      return hashing.sha256(request.auth.token.get('email', '').lower().toUtf8()).toHexString().lower();
    }
    function reservedOk(code) { return !isReserved(code) || myEmailHash() == reservedCodes()[code]; }

    function claimPath(appId, code) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/classroomClaims/$(code);
    }
    function memberPath(appId, code, uid) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/classroomClaims/$(code)/members/$(uid);
    }
    function isOwner(appId, code) {
      return isGoogle() && exists(claimPath(appId, code))
          && get(claimPath(appId, code)).data.ownerUid == request.auth.uid;
    }
    function isMember(appId, code) {
      return isGoogle() && exists(claimPath(appId, code))
          && exists(memberPath(appId, code, request.auth.uid))
          && get(memberPath(appId, code, request.auth.uid)).data.ownerUid
             == get(claimPath(appId, code)).data.ownerUid;
    }
    // 可以操作這間教室的老師：主人、協同老師；還沒有人申請的舊教室照舊開放（相容既有課堂）
    function isRoomTeacher(appId, code) {
      return isGoogle() && (!exists(claimPath(appId, code)) || isOwner(appId, code) || isMember(appId, code));
    }
    function canWriteRoom(appId, code) { return isAnon() || isRoomTeacher(appId, code); }

    function claimFieldsOk() {
      return request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'claimedAt', 'lastUsedAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() <= 100
          && request.resource.data.lastUsedAt == request.time;
    }

    match /artifacts/{appId}/public/data/classroomClaims/{code} {
      allow read: if signedIn();
      // 第一位申請的老師成為主人
      allow create: if isGoogle() && reservedOk(code) && claimFieldsOk()
                    && request.resource.data.claimedAt == request.time;
      // 主人更新（最後使用時間、顯示名稱）；不能把代碼轉給別人
      allow update: if isGoogle() && (
          (resource.data.ownerUid == request.auth.uid && claimFieldsOk()
             && request.resource.data.claimedAt == resource.data.claimedAt)
          // 協同老師只能更新最後使用時間
          || (isMember(appId, code)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUsedAt'])
             && request.resource.data.lastUsedAt == request.time)
          // 主人超過 30 天沒用：其他老師可以接手（保留代碼除外）
          || (resource.data.lastUsedAt < request.time - duration.value(30, 'd')
             && !isReserved(code) && claimFieldsOk()
             && request.resource.data.claimedAt == request.time)
        );
      allow delete: if isGoogle() && resource.data.ownerUid == request.auth.uid;

      match /invite/{inviteId} {
        allow read, write: if isOwner(appId, code);
      }

      match /members/{memberUid} {
        allow read: if isGoogle() && (request.auth.uid == memberUid || isOwner(appId, code));
        // 拿正確、7 天內的邀請碼才能加入
        allow create: if isGoogle() && request.auth.uid == memberUid
          && exists(claimPath(appId, code))
          && request.resource.data.keys().hasOnly(['ownerUid', 'joinCode', 'name', 'joinedAt'])
          && request.resource.data.ownerUid == get(claimPath(appId, code)).data.ownerUid
          && request.resource.data.joinedAt == request.time
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/classroomClaims/$(code)/invite/current)
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/classroomClaims/$(code)/invite/current).data.code
             == request.resource.data.joinCode
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/classroomClaims/$(code)/invite/current).data.createdAt
             > request.time - duration.value(7, 'd');
        allow delete: if isGoogle() && (request.auth.uid == memberUid || isOwner(appId, code));
      }
    }

    // 🆕 MODIFIED [V4.6.0] 教室公開資料（artifacts 路徑）
    // 讀取：任何登入用戶；寫入：學生（匿名）或這間教室的老師
    match /artifacts/{appId}/public/data/classrooms/{classroomCode} {
      allow read: if signedIn();
      allow write: if isRoomTeacher(appId, classroomCode);

      // 教室設定（control / peerReview）：只有這間教室的老師能寫
      match /settings/{settingId} {
        allow read: if signedIn();
        allow write: if isRoomTeacher(appId, classroomCode);
      }

      // 前端錯誤上報：任何登入用戶都能上報；清除由這間教室的老師或系統處理
      match /errors/{errorId} {
        allow read, create: if signedIn();
        allow delete: if canWriteRoom(appId, classroomCode);
      }

      // 其他子集合（studentResponses、presence、attendance、waitingGameScores、historicalQuizzes、
      // quickPoll、quickPollVotes、peerReviewVotes、teamScores、photoWall 等）
      match /{sub}/{rest=**} {
        allow read: if signedIn();
        allow write: if sub != 'settings' && sub != 'errors' && canWriteRoom(appId, classroomCode);
      }
    }

    // 其他 artifacts 路徑（例如 sharedBanks）：通用規則（保持向後相容）
    // 教室與教室代碼由上方規則把關，這裡排除，否則會被這條寬鬆規則放行
    match /artifacts/{appId}/public/{seg}/{document=**} {
      allow read, write: if signedIn() && seg != 'data';
    }
    match /artifacts/{appId}/public/data {
      allow read, write: if signedIn();
    }
    match /artifacts/{appId}/public/data/{coll}/{document=**} {
      allow read, write: if signedIn() && coll != 'classrooms' && coll != 'classroomClaims';
    }

    // 🆕 [V4.7.2] 共用 AI 每日次數（後端 callGemini 寫入）：Google 登入的老師只能讀自己今天那一筆，不能寫
    match /rateLimits/{docId} {
      allow read: if isGoogle()
                  && docId.matches('user_' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow write: if false;
    }

    // 禁止所有其他路徑
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
